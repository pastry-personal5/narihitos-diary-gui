{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Narihito's Diary",
  "version": "1.0.0",
  "identifier": "com.narihito.diary.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Narihito's Diary",
        "width": 1200,
        "height": 800,
        "minWidth": 780,
        "minHeight": 500
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": {
      "minimumSystemVersion": "26.7.1"
    },
    "icon": ["icons/icon.icns"],
    "resources": {
      "../assets/third-party/": "third-party/",
      "../third-party-notices.md": "third-party-notices.md"
    }
  }
}
