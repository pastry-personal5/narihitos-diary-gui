{
  "name": "narihitos-diary-gui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=11.20.0"
  },
  "scripts": {
    "check:versions": "node scripts/check-versions.mjs",
    "test": "vitest run",
